{
  "description": "Journals Claude Code session activity for Tickr time tracking. Hooks never use the network.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--no-warnings",
              "${CLAUDE_PLUGIN_ROOT}/hooks/dist/tickr-hook.cjs",
              "SessionStart"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--no-warnings",
              "${CLAUDE_PLUGIN_ROOT}/hooks/dist/tickr-hook.cjs",
              "UserPromptSubmit"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--no-warnings",
              "${CLAUDE_PLUGIN_ROOT}/hooks/dist/tickr-hook.cjs",
              "PostToolUse"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--no-warnings",
              "${CLAUDE_PLUGIN_ROOT}/hooks/dist/tickr-hook.cjs",
              "Stop"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--no-warnings",
              "${CLAUDE_PLUGIN_ROOT}/hooks/dist/tickr-hook.cjs",
              "SessionEnd"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--no-warnings",
              "${CLAUDE_PLUGIN_ROOT}/hooks/dist/tickr-hook.cjs",
              "SubagentStart"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--no-warnings",
              "${CLAUDE_PLUGIN_ROOT}/hooks/dist/tickr-hook.cjs",
              "SubagentStop"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}

{
  "name": "@coderise-fr/tickr-mcp",
  "version": "0.2.1",
  "description": "MCP server that lets an AI agent start, stop and edit your Tickr time entries.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "tickr-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coderise-fr/tickr-mcp.git"
  },
  "homepage": "https://github.com/coderise-fr/tickr-mcp#readme",
  "keywords": [
    "mcp",
    "tickr",
    "time-tracking",
    "model-context-protocol"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "node scripts/vitest.mjs run",
    "test:contract": "node scripts/vitest.mjs run --config vitest.contract.config.ts",
    "test:hook": "node scripts/vitest.mjs run --config vitest.hook.config.ts",
    "build:hook": "node scripts/build-hook.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vite": "8.3.6"
  }
}
